rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /gms/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /scenarios/{scenarioId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow update: if request.auth != null && request.auth.uid == resource.data.hostId;

      match /players/{playerId} {
        allow read: if request.auth != null && (
          request.auth.uid == playerId ||
          request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId
        );
        allow write: if false;
      }

      match /logs/{logId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId;
        allow write: if false;
      }

      match /accusations/{accuserId} {
        allow read: if request.auth != null && (
          request.auth.uid == accuserId ||
          request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId
        );
        allow write: if false;
      }
    }
  }
}
